scene library_route:
  bg library with fade(duration=400)
  show mio_stand at left with dissolve(duration=200)
  show ren_stand at right with dissolve(duration=200)
  particle dust intensity=light

  narration:
    図書室には、閉館後の光だけが残っていた。
    書架の間を、細かな埃がゆっくり流れていく。

  mio:
    この棚、文芸部の古い部誌が並んでる。
    ノートと同じ筆跡のタイトルもあるよ。

  ren:
    ここに鍵が挟まってる。
    「視聴覚室」と書いてあるから、最後のページの続きはそこかもしれない。

  set scenario.hasKey = true
  call system.unlockCg(id=libraryBookmark)
  se page
  jump after_search

scene rooftop_route:
  bg rooftop with fade(duration=400)
  show mio_stand at left with dissolve(duration=200)
  show ren_stand at right with dissolve(duration=200)
  camera focus mio_stand zoom=1.12 duration=350

  narration:
    屋上には、まだ少しだけ夏の熱が残っていた。
    フェンスの影が、ノートの上で細く揺れている。

  mio:
    封筒の中身は、誰かの下書きみたい。
    でも宛名がないね。

  reset camera duration=300

  ren:
    こっちは鍵じゃない。
    でも「最後の一文は二人で決めて」と書いてある。

  set scenario.hasKey = false
  add scenario.trust += 1
  jump after_search

scene after_search:
  bg hallway with fade(duration=350)
  stopParticle

  if scenario.hasKey:
    narration:
      視聴覚室の鍵は、思ったより軽かった。
      二人は廊下の奥へ急ぐ。
  else:
    narration:
      封筒の下書きを胸にしまい、二人は廊下へ戻った。
      鍵はないけれど、ノートの続きはもう少しだけ読めそうだ。

  mio:
    返すだけなら、もう十分かもしれない。
    でも、最後のページが白紙なのが気になる。

  ren:
    白紙のまま返すか、短い返事を書いてから返すか。
    どっちも間違いではないと思う。

  choice "ノートをどう扱う？":
    "二人で続きを書く" id=writeTogether:
      add scenario.trust += 1
      jump write_together

    "元の棚へ戻す" id=returnNotebook:
      jump return_notebook

scene write_together:
  bg classroom with fade(duration=350)
  show mio_stand at left
  show ren_stand at right
  pulse message intensity=light duration=180

  narration:
    空き教室の机に、ノートをそっと開いた。
    窓の外では、駅の明かりがひとつずつ灯っていく。

  mio:
    「なくした物語は、誰かが拾った時点で続きになる」
    こんな感じでどうかな。

  ren:
    いいと思う。
    返す人にも、拾った人にも残る一文だ。

  jump ending_check

scene return_notebook:
  bg library with fade(duration=350)
  show mio_stand at left
  show ren_stand at right

  narration:
    二人はノートを部誌の棚へ戻した。
    栞だけが少し前に出て、次に見つける人を待っている。

  mio:
    勝手に続きを書かないのも、ひとつの返し方だよね。

  ren:
    うん。白紙を残す勇気も、物語の一部だと思う。

  jump ending_check
