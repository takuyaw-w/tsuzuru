scene focus_choice:
  choice "どの音を先に詳しく聞く？":
    "澄んだ tone を聞く" id=focusTone:
      se page
      jump focus_tone

    "ざらついた noize を聞く" id=focusNoize:
      se page
      jump focus_noize

    "重ねた mix を聞く" id=focusMix:
      se page
      jump focus_mix

scene focus_tone:
  tone:
    では tone をもう少し詳しく。
    音高があると、文字の列に細い線が通る。

  tone:
    高すぎると落ち着かないし、低すぎると足音みたいになる。
    今の C5 は、説明役として少し明るい。

  tone:
    でも画面を占領しない高さを狙っている。

  noize:
    トーンの音は、輪郭がはっきりしている。
    私の noise よりも、どこで文字が出たのか分かりやすい。

  mix:
    そのかわり、長い文章では規則正しさが目立つこともある。
    だから volume と duration は短めにする。

  mix:
    文字の後ろにそっと置くのが大事。

  jump effect_choice

scene focus_noize:
  noize:
    では noize の時間。
    noise は、音程を聞かせるより、ページのざらつきを感じさせる。

  noize:
    古い視聴覚室の空調、カセットの無音部分、紙の束をめくる指。
    そういう細かいものを、一文字ずつ小さく散らす。

  tone:
    高さがないから、読み手の頭の中の声を邪魔しにくいね。

  mix:
    一方で、音の芯が必要な場面では少し弱く感じるかもしれない。
    そこを補うために、mix では小さな tone layer を重ねている。

  jump effect_choice

scene focus_mix:
  mix:
    では mix を聞いて。
    私の profile は E5 の triangle tone を使う。

  mix:
    そこに white noise を重ねている。

  mix:
    triangle は sine より少しだけ存在感がある。
    noise を薄く入れると、息のある合図になる。

  tone:
    tone だけの明るさより、少し実用向けに丸くなる。

  noize:
    noise だけのざらつきより、文字の位置が見えやすくなる。

  jump effect_choice

scene effect_choice:
  choice "今度は、どの effect を試す？":
    "shake を試す" id=tryShake:
      jump effect_shake

    "flash を試す" id=tryFlash:
      jump effect_flash

    "pulse を試す" id=tryPulse:
      jump effect_pulse

    "blur を試す" id=tryBlur:
      jump effect_blur

scene effect_shake:
  noize:
    まずは shake。
    画面全体が短く揺れる。

  shake screen intensity=strong duration=420
  se page

  tone:
    衝撃や落下、遠くの爆発に使いやすい。

  jump effect_choice_after

scene effect_flash:
  tone:
    次は flash。
    一瞬だけ画面に光を入れる。

  flash color="#ffffff" duration=140
  se page

  mix:
    雷、カメラのフラッシュ、気づきの演出に向いている。

  jump effect_choice_after

scene effect_pulse:
  mix:
    pulse は、画面やメッセージを一瞬だけ押し出す。

  pulse message intensity=strong duration=260
  se page

  noize:
    心音、強調、クリック感に使える。

  jump effect_choice_after

scene effect_blur:
  tone:
    blur は、視界の輪郭をゆっくり滲ませる。

  blur screen amount=8 duration=420
  se page

  mix:
    めまい、回想、意識が遠のく場面に向いている。

  jump effect_choice_after

scene effect_choice_after:
  choice "もう一度 effect を試す？":
    "別の effect を試す" id=tryAnotherEffect:
      jump effect_choice

    "Text Sound Lab に戻る" id=returnToLab:
      jump camera_choice

scene camera_choice:
  choice "camera demo を試す？":
    "camera focus を見る" id=tryCameraFocus:
      jump camera_focus_demo

    "Text Sound Lab に戻る" id=skipCameraDemo:
      jump particle_choice

scene camera_focus_demo:
  camera focus tone_stand zoom=1.2 duration=400

  tone:
    まずは、僕に寄ってみよう。

  camera focus noize_stand zoom=1.2 duration=400

  noize:
    次は私。画面の重心が少し変わる。

  camera focus mix_stand zoom=1.18 duration=400 easing=easeOut

  mix:
    focus は、会話の視線を作るための camera state。

  pulse message intensity=light duration=180
  camera x=0 y=-20 zoom=1.08 duration=500

  narration:
    三人を少し引き締めるように、画面全体が寄った。

  reset camera duration=400

  narration:
    カメラは、元の位置へ戻った。

  jump particle_choice

scene particle_choice:
  choice "particle demo を試す？":
    "雨を降らせる" id=particleRain:
      jump particle_rain

    "雪を降らせる" id=particleSnow:
      jump particle_snow

    "桜を舞わせる" id=particleSakura:
      jump particle_sakura

    "埃を漂わせる" id=particleDust:
      jump particle_dust

    "Text Sound Lab に戻る" id=returnToLab:
      jump after_focus

scene particle_rain:
  particle rain intensity=normal

  noize:
    雨は、画面全体の空気を冷たくする。

  jump particle_after

scene particle_snow:
  particle snow intensity=light

  tone:
    雪は、音を少しだけ遠ざける。

  jump particle_after

scene particle_sakura:
  particle sakura intensity=normal

  mix:
    桜は、場面を少しだけ柔らかくする。

  jump particle_after

scene particle_dust:
  particle dust intensity=light

  narration:
    埃が光の中をゆっくり漂っている。

  jump particle_after

scene particle_after:
  choice "particle を止める？":
    "止める" id=stopParticleDemo:
      stopParticle
      jump after_focus

    "別の particle を試す" id=tryAnotherParticle:
      jump particle_choice

scene after_focus:
  narration:
    メトロノームが一度だけ止まり、三人は同じ原稿を手に取った。

  tone:
    短い音は、読み進める速度を少しだけ整える。
    音が強すぎると急かされるけれど、ちょうどよければ文章が前へ進む。

  noize:
    無音も悪くない。
    でも、ほんの少しだけ粒があると、画面が眠らない。

  noize:
    夜の教室なら、蛍光灯のかすかな震えみたいに聞こえる。

  mix:
    最後は好みの問題。
    澄んだ合図が好きな人もいるし、紙のような音が好きな人もいる。

  mix:
    重ねた音は、その間を探すための道具になる。

  choice "最後に、どの text sound が好き？":
    "tone の澄んだ音" id=likeTone:
      se page
      jump like_tone

    "noize のざらつき" id=likeNoize:
      se page
      jump like_noize

    "mix の重なり" id=likeMix:
      se page
      jump like_mix
