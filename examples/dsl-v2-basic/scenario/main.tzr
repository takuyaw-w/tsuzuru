title "DSL v2 Basic"

character mio name="美緒"

scene start:
  bg station
  bgm daily_theme
  show mio_smile at center

  mio:
    遅いよ。

  set scenario.hasNotebook = true
  set scenario.selectedItem = null
  set scenario.currentSpeaker = "mio"
  set scenario.lastSpeaker = scenario.currentSpeaker
  add scenario.score += 1

  if scenario.score >= 1:
    narration:
      スコアが増えた。
  else:
    narration:
      まだ何も起きていない。

  choice "どうする？":
    "手帳を見る" id=openNotebook if scenario.hasNotebook:
      se page
      jump notebook

    "立ち去る" id=leave:
      jump leave

scene notebook:
  wait 250
  voice mio_001
  mio:
    ちゃんと見ておいてね。
  hide mio_smile
  stopBgm
  end

scene leave:
  narration:
    駅をあとにした。
  stopBgm
  end
