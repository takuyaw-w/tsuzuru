{
  "name": "@tsuzuru/vue",
  "version": "0.1.1",
  "description": "Vue runtime adapter and convenience runtime view for Tsuzuru.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.*",
    "dist/runtime-save.*",
    "dist/runtime-view.*",
    "dist/use-runtime.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/vue#readme",
  "keywords": [
    "tsuzuru",
    "visual-novel",
    "vue",
    "runtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/core build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/core build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsuzuru/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.34"
  }
}
