{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client", "@tsuzuru/vite-plugin/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tsuzuru.config.ts"]
}
