{
  "name": "create-tsuzuru",
  "version": "1.0.0",
  "description": "Minimal project generator for Tsuzuru.",
  "keywords": [
    "create",
    "scaffold",
    "tsuzuru",
    "visual-novel",
    "vite"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/create-tsuzuru#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/create-tsuzuru"
  },
  "bin": {
    "create-tsuzuru": "./dist/src/index.js"
  },
  "files": [
    "dist/src/create-project.*",
    "dist/src/index.*",
    "dist/src/template.*",
    "templates",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
