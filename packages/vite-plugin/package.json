{
  "name": "@tsuzuru/vite-plugin",
  "version": "1.0.0",
  "description": "Vite plugin for importing Tsuzuru .tzr scenario files as compiled runtime documents.",
  "keywords": [
    "scenario",
    "tsuzuru",
    "visual-novel",
    "vite"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/vite-plugin#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist/src/client.*",
    "dist/src/index.*"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json && node scripts/copy-client-types.mjs",
    "test": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@tsuzuru/config": "workspace:^",
    "@tsuzuru/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  }
}
