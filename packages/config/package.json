{
  "name": "@tsuzuru/config",
  "version": "1.0.0",
  "description": "Project configuration helpers for Tsuzuru.",
  "keywords": [
    "config",
    "tsuzuru",
    "visual-novel"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/config"
  },
  "files": [
    "dist/src/index.*",
    "dist/src/node.*"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
