{
  "name": "@tsuzuru/cli",
  "version": "0.1.1",
  "description": "Command line tools for checking Tsuzuru projects.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tsuzuru": "./dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/check.*",
    "dist/src/config-loader.*",
    "dist/src/index.*",
    "dist/src/scenario-files.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/cli#readme",
  "keywords": [
    "tsuzuru",
    "visual-novel",
    "cli",
    "scenario"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsuzuru/config": "workspace:^",
    "@tsuzuru/core": "workspace:^",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.16"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
