{
  "name": "@tsuzuru/cli",
  "version": "1.0.0",
  "description": "Command line tools for checking Tsuzuru projects.",
  "keywords": [
    "cli",
    "scenario",
    "tsuzuru",
    "visual-novel"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/cli"
  },
  "bin": {
    "tsuzuru": "./dist/src/index.js"
  },
  "files": [
    "dist/src/check.*",
    "dist/src/config-loader.*",
    "dist/src/errors.*",
    "dist/src/index.*",
    "dist/src/scenario-files.*"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/config build && pnpm --filter @tsuzuru/core build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@tsuzuru/config": "workspace:^",
    "@tsuzuru/core": "workspace:^",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
