{
  "name": "@tsuzuru/standard-ui-preact",
  "version": "1.0.0",
  "description": "Reusable Preact UI components for Tsuzuru visual novel screens.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/atoms/**",
    "dist/assets.*",
    "dist/ChoiceLayer.*",
    "dist/GameShell.*",
    "dist/MessageWindow.*",
    "dist/RuntimeMessageLayer.*",
    "dist/StatusLayer.*",
    "dist/class-name.*",
    "dist/game-viewport.*",
    "dist/index.*",
    "dist/layouts/**",
    "dist/molecules/**",
    "dist/organisms/**",
    "dist/runtime-control-bar.*",
    "dist/screen-host.*",
    "dist/std-audio-layer.*",
    "dist/std-audio-runtime-layer.*",
    "dist/std-audio-status-panel.*",
    "dist/std-effect-layer.*",
    "dist/std-particle-layer.*",
    "dist/std-particle-presentation.*",
    "dist/std-particle-runtime-layer.*",
    "dist/std-visual-layer.*",
    "dist/style.css",
    "dist/tsuzuru-game.*",
    "dist/useAutoMode.*",
    "dist/useMessageHistory.*",
    "dist/useStdAudioNotices.*",
    "dist/useTextReveal.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/standard-ui-preact"
  },
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/standard-ui-preact#readme",
  "keywords": [
    "tsuzuru",
    "visual-novel",
    "preact",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/preact build && pnpm --filter @tsuzuru/plugin-std-visual build && pnpm --filter @tsuzuru/plugin-std-audio build && pnpm --filter @tsuzuru/plugin-std-effect build && pnpm --filter @tsuzuru/plugin-std-particle build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/preact build && pnpm --filter @tsuzuru/plugin-std-visual build && pnpm --filter @tsuzuru/plugin-std-audio build && pnpm --filter @tsuzuru/plugin-std-effect build && pnpm --filter @tsuzuru/plugin-std-particle build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsuzuru/core": "workspace:^",
    "@tsuzuru/plugin-std-audio": "workspace:^",
    "@tsuzuru/plugin-std-effect": "workspace:^",
    "@tsuzuru/plugin-std-particle": "workspace:^",
    "@tsuzuru/plugin-std-visual": "workspace:^",
    "@tsuzuru/preact": "workspace:^"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "preact": "^10.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
