{
  "name": "@tsuzuru/plugin-std-text-sound",
  "version": "1.0.0",
  "description": "Standard text sound plugin state and command handlers for Tsuzuru.",
  "keywords": [
    "plugin",
    "text-sound",
    "tsuzuru",
    "visual-novel"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/plugin-std-text-sound#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/plugin-std-text-sound"
  },
  "files": [
    "dist/src/browser.*",
    "dist/src/index.*"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/core build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/core build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsuzuru/core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
