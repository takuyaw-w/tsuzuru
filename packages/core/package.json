{
  "name": "@tsuzuru/core",
  "version": "1.0.0",
  "description": "Core parser, compiler, project compiler, and runtime primitives for Tsuzuru.",
  "keywords": [
    "dsl",
    "runtime",
    "scenario",
    "tsuzuru",
    "visual-novel"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/src/ast.*",
    "dist/src/commands.*",
    "dist/src/compiler.*",
    "dist/src/condition-evaluator.*",
    "dist/src/condition-parser.*",
    "dist/src/diagnostic.*",
    "dist/src/index.*",
    "dist/src/ir.*",
    "dist/src/parser.*",
    "dist/src/plugin-command.*",
    "dist/src/project-compiler.*",
    "dist/src/runtime.*",
    "dist/src/runtime-args.*",
    "dist/src/runtime-commands.*",
    "dist/src/runtime-control.*",
    "dist/src/runtime-frames.*",
    "dist/src/runtime-save-slot.*",
    "dist/src/runtime-snapshot.*",
    "dist/src/runtime-types.*",
    "dist/src/scenario-ast.*"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
