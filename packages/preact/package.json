{
  "name": "@tsuzuru/preact",
  "version": "1.0.0",
  "description": "Preact runtime adapter and convenience runtime view for Tsuzuru.",
  "keywords": [
    "preact",
    "runtime",
    "tsuzuru",
    "visual-novel"
  ],
  "homepage": "https://github.com/tsuzuru-engine/tsuzuru/tree/main/packages/preact#readme",
  "bugs": {
    "url": "https://github.com/tsuzuru-engine/tsuzuru/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuzuru-engine/tsuzuru.git",
    "directory": "packages/preact"
  },
  "files": [
    "dist/index.*",
    "dist/runtime-save.*",
    "dist/runtime-view.*",
    "dist/use-runtime.*"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @tsuzuru/core build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "typecheck": "pnpm --filter @tsuzuru/core build && pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tsuzuru/core": "workspace:^"
  },
  "devDependencies": {
    "preact": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  }
}
